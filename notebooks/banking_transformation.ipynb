   "source": [
    "# Load CSV files from Silver layer with correct file names\n",
    "base_path = f\"abfss://silver@{storage_account_name}.dfs.core.windows.net/processed\"\n",
    "\n",
    "df_transactions = spark.read.option(\"header\", \"true\").option(\"inferSchema\", \"true\").csv(f\"{base_path}/core_banking_transactions.csv\")\n",
    "df_clients = spark.read.option(\"header\", \"true\").option(\"inferSchema\", \"true\").csv(f\"{base_path}/client_master.csv\")\n",
    "df_accounts = spark.read.option(\"header\", \"true\").option(\"inferSchema\", \"true\").csv(f\"{base_path}/account_details.csv\")\n",
    "\n",
    "print(f\" Transactions: {df_transactions.count()} rows\")\n",
    "print(f\" Clients: {df_clients.count()} rows\")\n",
    "print(f\" Accounts: {df_accounts.count()} rows\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "inputWidgets": {},
     "nuid": "316ea66e-e15e-4d13-bc82-00b24ab08530",
     "showTitle": false,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " Cleaned Transactions: 30 rows\nroot\n |-- transaction_id: string (nullable = true)\n |-- client_id: string (nullable = true)\n |-- account_number: string (nullable = true)\n |-- transaction_date: timestamp (nullable = true)\n |-- transaction_type: string (nullable = true)\n |-- amount: double (nullable = true)\n |-- currency: string (nullable = true)\n |-- merchant_name: string (nullable = true)\n |-- merchant_category: string (nullable = true)\n |-- location: string (nullable = true)\n |-- country_code: string (nullable = true)\n |-- channel: string (nullable = true)\n |-- status: string (nullable = true)\n |-- is_flagged: integer (nullable = true)\n |-- flag_reason: string (nullable = true)\n\n"
     ]
    }
   ],
   "source": [
    "#Clean & Standardize Data\n",
    "\n",
    "from pyspark.sql.functions import col, to_timestamp, upper, trim, when\n",
    "\n",
    "# Standardize transaction data\n",
    "df_transactions_clean = df_transactions \\\n",
    "    .withColumn(\"transaction_date\", to_timestamp(col(\"transaction_date\"), \"yyyy-MM-dd HH:mm:ss\")) \\\n",
    "    .withColumn(\"transaction_type\", upper(trim(col(\"transaction_type\")))) \\\n",
    "    .withColumn(\"currency\", upper(trim(col(\"currency\")))) \\\n",
    "    .withColumn(\"status\", upper(trim(col(\"status\")))) \\\n",
    "    .withColumn(\"amount\", col(\"amount\").cast(\"double\")) \\\n",
    "    .withColumn(\"is_flagged\", col(\"is_flagged\").cast(\"integer\")) \\\n",
    "    .dropDuplicates([\"transaction_id\"])\n",
    "\n",
    "print(f\" Cleaned Transactions: {df_transactions_clean.count()} rows\")\n",
    "df_transactions_clean.printSchema()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "inputWidgets": {},
     "nuid": "d6ae05de-8d65-4bc6-9d86-0b0008e231d7",
     "showTitle": false,
