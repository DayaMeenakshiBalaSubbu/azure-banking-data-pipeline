     "output_type": "stream",
     "text": [
      " Final Dataset with Fraud Scores: 30 rows\n+---------------+----------+---------+-------+----------+----------------------+-----------+\n|transaction_id |first_name|last_name|amount |is_flagged|fraud_rule_triggered  |fraud_score|\n+---------------+----------+---------+-------+----------+----------------------+-----------+\n|TXN-2024-000029|Ashley    |White    |50000.0|1         |UNUSUALLY_LARGE_CREDIT|90         |\n|TXN-2024-000006|Michael   |Brown    |2500.0 |0         |NONE                  |10         |\n|TXN-2024-000010|Jennifer  |Davis    |750.0  |0         |NONE                  |10         |\n|TXN-2024-000025|Amanda    |Thomas   |0.01   |1         |MICRO_TRANSACTION     |90         |\n|TXN-2024-000005|Emily     |Williams |50.0   |0         |NONE                  |10         |\n|TXN-2024-000002|Sarah     |Mitchell |5000.0 |0         |EXCEEDS_DAILY_LIMIT   |60         |\n|TXN-2024-000016|Daniel    |Jackson  |89.99  |0         |NONE                  |10         |\n|TXN-2024-000001|James     |Anderson |1500.0 |0         |NONE                  |10         |\n|TXN-2024-000011|David     |Wilson   |10000.0|1         |LARGE_WIRE_TRANSFER   |90         |\n|TXN-2024-000023|Jennifer  |Davis    |560.0  |0         |NONE                  |10         |\n+---------------+----------+---------+-------+----------+----------------------+-----------+\nonly showing top 10 rows\n"
     ]
    }
   ],
   "source": [
    "# Fraud Detection Logic:\n",
    "\n",
    "from pyspark.sql.functions import lit\n",
    "\n",
    "# Apply fraud detection rules\n",
    "df_final = df_enriched \\\n",
    "    .withColumn(\"fraud_rule_triggered\",\n",
    "        when(col(\"is_flagged\") == 1, col(\"flag_reason\"))\n",
    "        .when(col(\"amount\") > col(\"daily_transaction_limit\"), lit(\"EXCEEDS_DAILY_LIMIT\"))\n",
    "        .when(col(\"risk_rating\") == \"HIGH\", lit(\"HIGH_RISK_CLIENT\"))\n",
    "        .otherwise(lit(\"NONE\"))\n",
    "    ) \\\n",
    "    .withColumn(\"fraud_score\",\n",
    "        when(col(\"is_flagged\") == 1, lit(90))\n",
    "        .when(col(\"risk_rating\") == \"HIGH\", lit(70))\n",
    "        .when(col(\"amount\") > col(\"daily_transaction_limit\"), lit(60))\n",
    "        .otherwise(lit(10))\n",
    "    )\n",
    "\n",
    "print(f\" Final Dataset with Fraud Scores: {df_final.count()} rows\")\n",
    "df_final.select(\n",
    "    \"transaction_id\",\n",
    "    \"first_name\",\n",
    "    \"last_name\",\n",
    "    \"amount\",\n",
    "    \"is_flagged\",\n",
    "    \"fraud_rule_triggered\",\n",
    "    \"fraud_score\"\n",
    ").show(10, truncate=False)\n"
   ]
  },
