   "source": [
    "# Check what's actually inside Silver container\n",
    "silver_path = f\"abfss://silver@{storage_account_name}.dfs.core.windows.net/\"\n",
    "\n",
    "# List all files recursively\n",
    "def list_files(path):\n",
    "    files = dbutils.fs.ls(path)\n",
    "    for f in files:\n",
    "        if f.isDir():\n",
    "            list_files(f.path)\n",
    "        else:\n",
    "            print(f.path)\n",
    "\n",
    "list_files(silver_path)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
