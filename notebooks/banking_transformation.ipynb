   "source": [
    "# Mount ADLS Gen2 Storage\n",
    "#Before writing transformation code we need to connect Databricks to our Data Lake\n",
    "storage_account_name = \"bankingdldaya\"\n",
    "storage_account_key = \"storage_account_key = "YOUR_STORAGE_ACCOUNT_KEY""\n",
    "spark.conf.set(\n",
    "    f\"fs.azure.account.key.{storage_account_name}.dfs.core.windows.net\",\n",
    "    storage_account_key\n",
    ")\n",
    "print(\" Storage connected successfully!\")\n"
   ]
