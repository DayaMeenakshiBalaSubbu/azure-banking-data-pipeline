   "source": [
    "# Write enriched data to Gold layer\n",
    "gold_path = f\"abfss://gold@{storage_account_name}.dfs.core.windows.net/banking_enriched\"\n",
    "\n",
    "df_final.write \\\n",
    "    .mode(\"overwrite\") \\\n",
    "    .option(\"header\", \"true\") \\\n",
    "    .csv(gold_path)\n",
    "\n",
    "print(f\" Data successfully written to Gold layer!\")\n",
    "print(f\" Path: {gold_path}\")\n",
    "\n",
    "# Verify files written\n",
    "files = dbutils.fs.ls(gold_path)\n",
    "print(f\"\\n Files in Gold layer:\")\n",
    "for f in files:\n",
    "    print(f\" → {f.name}\")"
   ]
  },
