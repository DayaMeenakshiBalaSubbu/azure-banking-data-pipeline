    }
   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " Enriched Dataset: 30 rows\n+---------------+-------------------+----------------+-------+--------+--------------------+-----------------+-----------+------------+-------------+---------+----------+----------------------+---------+----------+---------+------------------------+------------+----------+-----------+------------+--------------+---------------+-----------------------+--------------------+\n|transaction_id |transaction_date   |transaction_type|amount |currency|merchant_name       |merchant_category|location   |country_code|channel      |status   |is_flagged|flag_reason           |client_id|first_name|last_name|email                   |account_type|kyc_status|risk_rating|credit_score|account_number|current_balance|daily_transaction_limit|branch_name         |\n+---------------+-------------------+----------------+-------+--------+--------------------+-----------------+-----------+------------+-------------+---------+----------+----------------------+---------+----------+---------+------------------------+------------+----------+-----------+------------+--------------+---------------+-----------------------+--------------------+\n|TXN-2024-000029|2024-01-15 17:30:00|CREDIT          |50000.0|USD     |Unknown Source      |Unknown          |Zurich     |CH          |WIRE         |PENDING  |1         |UNUSUALLY_LARGE_CREDIT|CLT-1012 |Ashley    |White    |ashley.white@email.com  |PREMIUM     |VERIFIED  |MEDIUM     |770         |ACC-10012     |320000.0       |25000.0                |New York Main Branch|\n|TXN-2024-000006|2024-01-15 09:22:10|CREDIT          |2500.0 |USD     |Freelance Client XYZ|Freelance        |London     |GB          |BANK_TRANSFER|COMPLETED|0         |NULL                  |CLT-1005 |Michael   |Brown    |michael.brown@email.com |PREMIUM     |VERIFIED  |LOW        |800         |ACC-10005     |85000.0        |10000.0                |London Branch       |\n|TXN-2024-000010|2024-01-15 10:05:00|DEBIT           |750.0  |USD     |Best Buy Electronics|Electronics      |Seattle    |US          |POS          |COMPLETED|0         |NULL                  |CLT-1006 |Jennifer  |Davis    |jennifer.davis@email.com|STANDARD    |VERIFIED  |LOW        |725         |ACC-10006     |15300.0        |5000.0                 |Seattle Branch      |\n|TXN-2024-000025|2024-01-15 16:30:00|DEBIT           |0.01   |USD     |Test Merchant       |Unknown          |Beijing    |CN          |ONLINE       |COMPLETED|1         |MICRO_TRANSACTION     |CLT-1010 |Amanda    |Thomas   |amanda.thomas@email.com |BASIC       |PENDING   |HIGH       |580         |ACC-10010     |12000.0        |1000.0                 |Beijing Branch      |\n|TXN-2024-000005|2024-01-15 09:10:00|DEBIT           |50.0   |USD     |Starbucks           |Food & Beverage  |Los Angeles|US          |POS          |COMPLETED|0         |NULL                  |CLT-1004 |Emily     |Williams |emily.williams@email.com|BASIC       |VERIFIED  |LOW        |690         |ACC-10004     |5200.0         |2000.0                 |Los Angeles Branch  |\n+---------------+-------------------+----------------+-------+--------+--------------------+-----------------+-----------+------------+-------------+---------+----------+----------------------+---------+----------+---------+------------------------+------------+----------+-----------+------------+--------------+---------------+-----------------------+--------------------+\nonly showing top 5 rows\n"
     ]
    }
   ],
   "source": [
    "# Join transactions with clients and accounts\n",
    "df_enriched = df_transactions_clean \\\n",
    "    .join(df_clients, on=\"client_id\", how=\"left\") \\\n",
    "    .join(df_accounts, on=[\"account_number\", \"client_id\"], how=\"left\") \\\n",
    "    .select(\n",
    "        # Transaction fields\n",
    "        df_transactions_clean[\"transaction_id\"],\n",
    "        df_transactions_clean[\"transaction_date\"],\n",
    "        df_transactions_clean[\"transaction_type\"],\n",
    "        df_transactions_clean[\"amount\"],\n",
    "        df_transactions_clean[\"currency\"],  # Taking currency from transactions\n",
    "        df_transactions_clean[\"merchant_name\"],\n",
    "        df_transactions_clean[\"merchant_category\"],\n",
    "        df_transactions_clean[\"location\"],\n",
    "        df_transactions_clean[\"country_code\"],\n",
    "        df_transactions_clean[\"channel\"],\n",
    "        df_transactions_clean[\"status\"],\n",
    "        df_transactions_clean[\"is_flagged\"],\n",
    "        df_transactions_clean[\"flag_reason\"],\n",
    "        # Client fields\n",
    "        df_clients[\"client_id\"],\n",
    "        df_clients[\"first_name\"],\n",
    "        df_clients[\"last_name\"],\n",
    "        df_clients[\"email\"],\n",
    "        df_clients[\"account_type\"],\n",
    "        df_clients[\"kyc_status\"],\n",
    "        df_clients[\"risk_rating\"],\n",
    "        df_clients[\"credit_score\"],\n",
    "        # Account fields\n",
    "        df_accounts[\"account_number\"],\n",
    "        df_accounts[\"current_balance\"],\n",
    "        df_accounts[\"daily_transaction_limit\"],\n",
    "        df_accounts[\"branch_name\"]\n",
    "    )\n",
    "\n",
    "print(f\" Enriched Dataset: {df_enriched.count()} rows\")\n",
    "df_enriched.show(5, truncate=False)"
   ]
  },
